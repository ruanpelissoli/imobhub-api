# Copie para .env e preencha os valores. O .env é ignorado pelo git.
# As variáveis lidas pela aplicação passam apenas pelo pacote internal/config;
# as demais (POSTGRES_*, *_PORT) são usadas só pelo docker-compose.yml.

# --- Obrigatórias ---

# Connection string do PostgreSQL (formato aceito pelo pgx).
# O valor abaixo é o do banco do docker-compose visto a partir do host — use-o
# ao rodar `go run ./cmd/scraper`. Dentro do compose, o serviço `api`
# sobrescreve esta variável apontando para o host `db`.
DATABASE_URL=postgres://imobhub:imobhub@localhost:5432/imobhub?sslmode=disable

# Chave da API da Anthropic, usada na descoberta de seletores.
ANTHROPIC_API_KEY=

# --- Opcionais (valores abaixo são os defaults) ---

# Arquivo com a lista de fontes a serem raspadas.
SOURCES_FILE=sources.txt

# Diretório com os arquivos .sql de migration, aplicados no startup.
# Caminho relativo ao working directory do processo.
MIGRATIONS_DIR=migrations

# Arquivo YAML com o vocabulário de comodidades (nome canônico + sinônimos)
# usado pelo enriquecimento para extrair `amenities` da descrição do anúncio.
# Caminho relativo ao working directory do processo.
AMENITIES_FILE=configs/amenities.yaml

# User-Agent enviado em todas as requisições e usado na avaliação do robots.txt.
SCRAPER_USER_AGENT=ImobHubBot/1.0

# Intervalo mínimo, em milissegundos, entre requisições para o mesmo host.
# 0 desativa o rate limiting (não recomendado fora de testes locais).
SCRAPER_RATE_LIMIT_MS=2000

# Provider usado para converter endereço em coordenadas (lat/lng).
# Valores aceitos: nominatim (OpenStreetMap, gratuito e sem chave) e googlemaps.
# Um valor fora dessa lista é erro de boot, não fallback silencioso.
GEOCODING_PROVIDER=nominatim

# Chave da API do provider de geocodificação. Obrigatória APENAS quando
# GEOCODING_PROVIDER=googlemaps; o nominatim não usa chave nenhuma.
GEOCODING_API_KEY=

# Intervalo mínimo, em milissegundos, entre requisições ao provider de
# geocodificação. O Nominatim permite no máximo 1 req/s — abaixar isso rende
# bloqueio do User-Agent. 0 desativa (só para testes locais).
GEOCODING_RATE_LIMIT_MS=1000

# --- Agrupamento canônico de imóveis (internal/grouping) ---
# Este fluxo faz uma chamada PAGA à Anthropic por anúncio que chega com
# coordenadas e com algum imóvel já cadastrado por perto. As duas variáveis
# abaixo (raio e nº de candidatos) são o controle de custo dele.

# Confiança mínima, de 0 a 1, para aceitar que o anúncio é o mesmo imóvel de um
# candidato. Abaixo dela, um imóvel canônico novo é criado. O default é alto de
# propósito: juntar dois imóveis distintos é caro de desfazer, criar um
# duplicado não. Valor fora de [0,1] é erro de boot, não recorte silencioso.
GROUPING_CONFIDENCE_THRESHOLD=0.85

# Raio, em metros, da busca por imóveis candidatos em torno do anúncio.
# 100 m cobre a imprecisão típica da geocodificação de endereço sem varrer o
# quarteirão inteiro. Aumentar encarece o prompt; 0 ou negativo é erro de boot.
GROUPING_RADIUS_METERS=100

# Número máximo de imóveis candidatos enviados numa comparação. A busca já
# devolve do mais próximo ao mais distante, então o corte descarta os piores.
# 0 ou negativo é erro de boot (desligaria o agrupamento em silêncio).
GROUPING_MAX_CANDIDATES=5

# --- Fila de enriquecimento (internal/enrichqueue) ---

# Quantos anúncios pendentes são processados simultaneamente ao final de cada
# coleta. O ganho de subir esse número é assimétrico e isso é esperado: a
# geocodificação serializa em 1 req/s global (política do Nominatim), então quem
# realmente paraleliza são as chamadas PAGAS de IA do agrupamento — subir o valor
# aumenta o custo por unidade de tempo, não o total. 0 ou negativo é erro de boot
# (uma fila com zero workers parece "funcionando" nos logs e nunca processa nada).
ENRICHMENT_WORKERS=4

# Redis do docker-compose visto a partir do host. Nenhum pacote Go lê esta
# variável ainda (internal/config não a conhece): o serviço está no compose
# para o cache/fila previsto, e o dia em que for usado a leitura entra em
# internal/config como as demais.
REDIS_URL=redis://localhost:6379/0

# --- Apenas para o docker-compose ---

# Credenciais criadas no container do Postgres. Se alterar, ajuste a
# DATABASE_URL acima para combinar.
POSTGRES_USER=imobhub
POSTGRES_PASSWORD=imobhub
POSTGRES_DB=imobhub

# Portas publicadas no host. Mude se as padrão já estiverem ocupadas por um
# Postgres/Redis instalado localmente (lembre de ajustar DATABASE_URL/REDIS_URL).
POSTGRES_PORT=5432
REDIS_PORT=6379
